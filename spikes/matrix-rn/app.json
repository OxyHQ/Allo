{
  "expo": {
    "name": "Allo Matrix Spike",
    "slug": "allo-matrix-spike",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "so.oxy.allo.matrixspike",
      "supportsTablet": false
    },
    "android": {
      "package": "so.oxy.allo.matrixspike"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ]
  }
}

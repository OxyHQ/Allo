{
  "name": "matrix-web-spike",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.js",
    "web": "expo start --web --port 8141",
    "export": "bun run copy-wasm && expo export --platform web --output-dir dist",
    "serve": "bun run scripts/serve.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.8",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.4.0",
    "expo": "~57.0.6",
    "expo-constants": "~57.0.5",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "matrix-js-sdk": "^42.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.14",
    "puppeteer-core": "^25.4.0",
    "typescript": "~5.9.2"
  }
}

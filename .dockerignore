# Build context exclusions for backend Docker image.
# Keeps the context small and prevents host node_modules / build
# artifacts from leaking into the image (which would break the
# in-container install and bloat the image).

# Dependencies (always installed fresh inside the image)
**/node_modules

# The frontend and the SDK workspaces (@allo/core, @allo/react) are not part of
# the backend image, but their package.json files must remain available so
# `bun install --frozen-lockfile` can validate the workspace lockfile (their
# dependencies are not installed and their sources are not copied).
packages/frontend/*
!packages/frontend/package.json
packages/core/*
!packages/core/package.json
packages/react/*
!packages/react/package.json

# Tests never run in the image; nothing at runtime imports them.
**/__tests__

# Build output / caches
**/dist
**/.expo
**/.next
**/coverage
**/tsconfig.tsbuildinfo

# VCS / CI / editor
.git
.github
.gitignore
.vscode
.idea

# Local env files (secrets are injected at runtime). No .env.example either:
# nothing in the build or at runtime reads it.
**/.env
**/.env.*

# Docs and misc (`*.md` alone matches only the context root)
docs
**/*.md

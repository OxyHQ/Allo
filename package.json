{
  "name": "allo",
  "version": "2.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "allo Monorepo - Frontend and Backend",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/core": "6.1.0",
    "@oxy.so/contracts": "5.1.0",
    "@oxy.so/services": "12.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-core": "5.101.2",
    "react-native-safe-area-context": "5.10.1",
    "lightningcss": "1.30.1",
    "@oxy.so/telemetry": "2.1.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/mcp": "1.1.0",
    "react-native-css": "3.1.0-rc.0"
  },
  "resolutions": {
    "@isaacs/brace-expansion": "^5.0.1",
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/core": "6.1.0",
    "@oxy.so/contracts": "5.1.0",
    "@oxy.so/services": "12.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-core": "5.101.2",
    "react-native-safe-area-context": "5.10.1",
    "lightningcss": "1.30.1",
    "@oxy.so/telemetry": "2.1.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/mcp": "1.1.0",
    "react-native-css": "3.1.0-rc.0"
  },
  "scripts": {
    "dev": "bun run dev --filter '*'",
    "dev:frontend": "bun run --filter @allo/frontend dev",
    "dev:backend": "bun run --filter @allo/backend dev",
    "build": "bun run --filter '*' build",
    "build:shared-types": "bun run --filter @allo/shared-types build",
    "build:frontend": "bun run --filter @allo/frontend build",
    "build:backend": "bun run --filter @allo/backend build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run typecheck:backend && bun run typecheck:core && bun run typecheck:react && bun run typecheck:frontend",
    "typecheck:backend": "bun check -p packages/backend/tsconfig.json",
    "typecheck:frontend": "tsc --noEmit -p packages/frontend/tsconfig.json",
    "check:bundle-imports": "bun ./scripts/check-frontend-bundle-imports.mjs && bun ./scripts/test-check-frontend-bundle-imports.mjs",
    "check:web-bundle-budget": "bun ./scripts/check-web-export-budget.mjs",
    "test:performance-gates": "bun ./scripts/test-check-frontend-bundle-imports.mjs && bun ./scripts/test-check-web-export-budget.mjs && bun ./scripts/test-check-web-export-html.mjs",
    "lint": "biome check . && bun run --filter @allo/frontend lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "bun run --filter '*' clean && rm -rf node_modules",
    "install:all": "bun install",
    "start:frontend": "bun run --filter @allo/frontend start",
    "start:backend": "bun run --filter @allo/backend start",
    "postinstall": "bun run build:contracts && bun run --filter @oxy.so/allo-sdk build && bun run build:shared-types && bun run build:core && bun run build:react && bun scripts/prepare-call-worker.mjs",
    "test:edge": "bun test scripts/edge-worker.test.ts",
    "check:bun-pin": "bun ./scripts/check-bun-pin.mjs && bun ./scripts/test-check-bun-pin.mjs",
    "build:core": "bun run --filter @allo/core build",
    "build:react": "bun run --filter @allo/react build",
    "typecheck:core": "bun run --filter @allo/core typecheck",
    "typecheck:react": "bun run --filter @allo/react typecheck",
    "check:team-openapi": "bun scripts/check-team-openapi.ts",
    "build:contracts": "bun run --filter @oxy.so/allo-contracts build",
    "test:call-media:browser": "bun scripts/call-media-browser/run.ts",
    "check:web-export-html": "bun ./scripts/check-web-export-html.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.9.2",
    "react-native-worklets": "0.13.0",
    "typescript": "~5.9.2",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/contracts": "5.1.0",
    "@oxy.so/core": "6.1.0",
    "@oxy.so/services": "12.4.0",
    "@react-native/js-polyfills": "^0.88.0",
    "@tanstack/query-async-storage-persister": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "react-native-css": "3.1.0-rc.0"
  },
  "patchedDependencies": {
    "expo@58.0.14": "patches/expo@58.0.14.patch"
  }
}

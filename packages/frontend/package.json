{
  "name": "@allo/frontend",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "scripts": {
    "start": "RCT_METRO_PORT=8140 expo start --reset-cache --tunnel --clear",
    "dev": "RCT_METRO_PORT=8140 expo start --reset-cache --tunnel --clear",
    "android": "RCT_METRO_PORT=8140 expo run:android",
    "ios": "RCT_METRO_PORT=8140 expo run:ios",
    "web": "RCT_METRO_PORT=8140 expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build-web": "expo export --platform web --output-dir dist",
    "build-web:prod": "expo export --platform web --output-dir dist",
    "test": "jest --watchAll=false",
    "lint": "expo lint .",
    "clean": "rm -rf dist .expo"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|@noble|ts-mls|@hpke|@oxy\\.so|@scure|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^@oxy\\.so/bloom/surfaces$": "<rootDir>/__mocks__/bloom-surfaces.js"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      }
    }
  },
  "dependencies": {
    "@alia.onl/sdk": "^21.3.1",
    "@allo/core": "workspace:*",
    "@allo/react": "workspace:*",
    "@allo/shared-types": "workspace:*",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-dynamic-import": "^7.27.1",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@bitdrift/react-native": "^0.12.12",
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/app-integrity": "~58.0.2",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "144.2.0",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@oxy.so/app-preset": "^3.3.0",
    "@oxy.so/bloom": "14.0.0",
    "@oxy.so/core": "6.0.0",
    "@oxy.so/expo-splash": "^1.1.0",

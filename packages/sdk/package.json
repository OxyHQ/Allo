{
  "name": "@oxy.so/allo-sdk",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OxyHQ/Allo.git",
    "directory": "packages/sdk"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test --no-env-file ./src/__tests__"
  },
  "dependencies": {
    "@oxy.so/allo-contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@oxy.so/core": "7.3.0",
    "@oxy.so/contracts": "6.0.0",
    "@oxy.so/protocol": "1.5.1"
  },
  "peerDependencies": {
    "@oxy.so/core": ">=7.0.0 <8"
  },
  "peerDependenciesMeta": {
    "@oxy.so/core": {
      "optional": true
    }
  }
}

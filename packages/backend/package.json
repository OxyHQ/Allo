{
  "name": "@allo/backend",
  "version": "1.0.0",
  "private": true,
  "author": "",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "db:check-locks": "oxy-db-check-migration-locks --migrations=drizzle --after=12 --hot-tables=client_instances,conversation_events,conversation_members,conversations,user_settings",
    "start": "bun server.ts",
    "dev": "bun --watch server.ts",
    "build": "tsc",
    "test": "bun test --parallel --no-env-file --preload ./src/__tests__/setup.ts --timeout 30000 ./src/__tests__",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@allo/shared-types": "workspace:*",
    "@crowdsource.you/contracts": "1.1.1",
    "@crowdsource.you/core": "3.1.0",
    "@oxy.so/contracts": "6.0.0",
    "@oxy.so/core": "7.3.0",
    "@oxy.so/db": "^1.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "0.45.4",
    "express": "^4.22.2",
    "express-rate-limit": "^8.0.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.0.0",
    "livekit-server-sdk": "^2.17.0",
    "postgres": "3.4.9",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3",
    "@oxy.so/homiio-sdk": "0.2.0",
    "@oxy.so/homiio-contracts": "0.2.1",
    "@oxy.so/allo-contracts": "workspace:*",
    "@aws-sdk/credential-provider-node": "3.972.83"
  },
  "devDependencies": {
    "@allo/core": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.3",
    "bun-types": "1.4.3",
    "drizzle-kit": "0.31.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "@oxy.so/allo-sdk": "workspace:*"
  }
}

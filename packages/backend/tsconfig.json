{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": "./",
    "outDir": "dist",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "bun-types"],
    "composite": true,
    "paths": {
      "@allo/shared-types": ["../shared-types/src"],
      "@allo/shared-types/*": ["../shared-types/src/*"]
    }
  },
  "include": ["**/*.ts", "package.json"],
  "references": [
    {
      "path": "../shared-types"
    }
  ]
}

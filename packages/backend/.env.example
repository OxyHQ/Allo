# Allo backend — environment
#
# Copy to `.env` and fill in. NO VALUES ARE COMMITTED HERE, and none should be:
# `.env` is gitignored, this file is not.
#
# Only the variables that are always needed, plus Allo's own credential for
# calling Oxy, are written out here. Push notifications and CrowdSource each
# validate their own variables in `src/config/push.ts` and
# `src/config/crowdsource.ts`, with the reasoning next to each rule — a second
# copy of those names in this file would be a list that agrees with the schema
# until the day it does not, and the day it does not is a deployment that boots
# with a variable that decides nothing.


# ─── Core ────────────────────────────────────────────────────────────────────

# PostgreSQL connection string, INCLUDING the database name. REQUIRED — this is
# the only store the service has, and `server.ts` refuses to boot without it
# rather than serving 500s from whichever route is hit first.
DATABASE_URL=

# `development` | `production`.
NODE_ENV=

# Local development only. ECS injects 8080; `server.ts` defaults to 4140.
PORT=

# The Postgres server the TEST suite creates its throwaway databases on — point
# it at a maintenance database (`/postgres`), never one holding anything, since
# each run creates and drops `oxydb_test_<hex>` against it. Falls back to
# DATABASE_URL when unset. `docker-compose.postgres.yml` brings up a local one.
TEST_DATABASE_URL=


# ─── Messaging platform ──────────────────────────────────────────────────────

# Redis, for the Socket.IO adapter so a room emit on one ECS task reaches a
# socket on another. OPTIONAL: unset, or unreachable within 5 s, means the
# server runs single-instance and logs so — never a boot failure. Shared across
# Oxy apps in production (SSM `/oxy/_shared/REDIS_URL`).
REDIS_URL=

# The largest blob `POST /v1/blobs` accepts, in bytes. Optional; the contract's
# default (`DEFAULT_MAX_BLOB_BYTES`, 25 MiB) applies when unset. A larger body
# is refused with 413 before it is read.
ALLO_BLOB_MAX_BYTES=

# History transfer and backups (Phase 3) add NO variable. Their retention is
# fixed by the contract and the schema rather than the environment: a history
# offer lives 7 days (`HISTORY_OFFER_TTL_MS` in @allo/shared-types), and a chunk
# blob released by consume, expiry, replacement or backup deletion lives one
# more day (`CHUNK_RELEASE_TTL_MS` in src/db/platform/historyRepository.ts). The
# routes are `POST /v1/instances/:id/history-offers`, `GET /v1/instances/me/
# history-offers`, `POST …/history-offers/:id/consume`, `PUT/GET/DELETE
# /v1/accounts/me/backup` and `PUT /v1/instances/me/transfer-key`, all
# instance-signed; see README.md, "History transfer and backups".

# Push notification providers, for the delivery worker. Each platform is
# all-or-nothing and validated at boot by `src/config/push.ts`: FCM needs
# FIREBASE_PROJECT_ID and FIREBASE_SERVICE_ACCOUNT_BASE64; APNs needs
# ALLO_APNS_KEY_ID, ALLO_APNS_TEAM_ID, ALLO_APNS_PRIVATE_KEY_BASE64 and
# ALLO_APNS_TOPIC (plus ALLO_APNS_ENVIRONMENT=production|sandbox). Neither set
# is a deployment without push, which is valid. The notification never carries
# content: title "Allo", body "New message", data = conversation and event ids.


# ─── Oxy ─────────────────────────────────────────────────────────────────────

# The Oxy API base URL. Read by @oxy.so/core itself, not by any Allo module, and
# defaults to https://api.oxy.so. Set it only to point at a non-production Oxy.
OXY_API_URL=

# Allo's own credential for calling the Oxy API as itself, minted at
# console.oxy.so → Apps → Allo → Settings → Credentials with type `Service`.
# The secret is shown exactly once.
#
# BOTH OR NEITHER — the process refuses to boot with one of the two.
#
# Optional. Every Oxy route the directory uses is public, so the lookups work
# without a credential; what it changes is that bulk profile fetches take the
# server-to-server path instead of an anonymous one, and that Oxy attributes the
# traffic to Allo rather than to a datacentre IP. See `src/config/oxyService.ts`.
ALLO_OXY_SERVICE_API_KEY=
ALLO_OXY_SERVICE_API_SECRET=

# Publish aggregate service traffic and infrastructure to the Oxy dashboard.
OXY_ECOSYSTEM_ACTIVITY_ENABLED=false
AWS_REGION=us-west-2
